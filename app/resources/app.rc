#include <windows.h>
#include <commctrl.h>
#include "../ui/Resource.h"

#pragma code_page(65001)

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDI_APP ICON "app.ico"

IDD_ADD_URL DIALOGEX 0, 0, 312, 58
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ajouter un téléchargement"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Adresse", IDC_ADD_LBL_URL, 10, 14, 40, 10
    EDITTEXT        IDC_ADD_URL, 52, 13, 188, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 250, 12, 52, 14, WS_TABSTOP
    LTEXT           "Source", IDC_ADD_LBL_SOURCE, 10, 36, 40, 10
    COMBOBOX        IDC_ADD_SOURCE, 52, 34, 188, 140, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    PUSHBUTTON      "Annuler", IDCANCEL, 250, 34, 52, 14, WS_TABSTOP
END

IDD_ADD_INFO DIALOGEX 0, 0, 360, 146
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Info sur le téléchargement"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    RTEXT           "URL", IDC_ADD_LBL_INFO_URL, 6, 14, 56, 10
    EDITTEXT        IDC_ADD_INFO_URL, 68, 12, 202, 12, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    RTEXT           "Icône du dossier", IDC_ADD_LBL_TEMPLATE, 6, 36, 56, 10
    COMBOBOX        IDC_ADD_TEMPLATE, 68, 34, 160, 160, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    RTEXT           "Enregistrer sous", IDC_ADD_LBL_DEST, 6, 58, 56, 10
    EDITTEXT        IDC_ADD_DEST, 68, 56, 182, 12, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", IDC_ADD_BROWSE, 254, 55, 16, 14, WS_TABSTOP
    AUTOCHECKBOX    "Rappeler ce chemin", IDC_ADD_REMEMBER, 68, 78, 202, 10, WS_TABSTOP
    RTEXT           "Épisodes", IDC_ADD_LBL_EPISODES, 6, 97, 56, 10
    PUSHBUTTON      "", IDC_ADD_PICK, 68, 95, 202, 14, WS_TABSTOP
    CONTROL         "", IDC_ADD_POSTER, "Static", SS_OWNERDRAW | SS_NOTIFY, 288, 22, 60, 68
    CTEXT           "", IDC_ADD_COUNT, 282, 96, 72, 10
    PUSHBUTTON      "Plus tard", IDC_ADD_LATER, 94, 119, 52, 14, WS_TABSTOP
    DEFPUSHBUTTON   "Démarrer", IDOK, 154, 119, 52, 14, WS_TABSTOP
    PUSHBUTTON      "Annuler", IDCANCEL, 214, 119, 52, 14, WS_TABSTOP
END

IDD_ADD_EPISODES DIALOGEX 0, 0, 360, 164
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Épisodes à télécharger"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Épisodes :", IDC_ADD_LBL_EPISODES, 12, 16, 60, 10
    CONTROL         "", IDC_ADD_PLAYER, "Button", BS_OWNERDRAW | WS_TABSTOP, 214, 11, 134, 18
    LTEXT           "Sélection :", IDC_ADD_LBL_SELECTION, 12, 39, 60, 10
    EDITTEXT        IDC_ADD_SELECTION, 76, 37, 272, 12, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "", IDC_ADD_EPISODES, "SysListView32",
                    LVS_SMALLICON | LVS_SHOWSELALWAYS | WS_BORDER |
                    WS_VSCROLL | WS_TABSTOP, 12, 56, 336, 62
    LTEXT           "", IDC_ADD_HINT, 12, 124, 200, 10
    RTEXT           "", IDC_ADD_COUNTER, 220, 124, 128, 10
    DEFPUSHBUTTON   "OK", IDOK, 236, 141, 52, 14, WS_TABSTOP
    PUSHBUTTON      "Annuler", IDCANCEL, 296, 141, 52, 14, WS_TABSTOP
END

IDD_ABOUT DIALOGEX 0, 0, 260, 116
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "À propos"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Anime Download Manager", IDC_STATIC, 16, 16, 228, 12
    LTEXT           "Version 0.1.0", IDC_STATIC, 16, 34, 228, 10
    LTEXT           "Gestionnaire de téléchargement d'animés pour Windows (C++ / Win32).",
                    IDC_ABOUT_TAGLINE, 16, 52, 228, 24
    DEFPUSHBUTTON   "OK", IDOK, 102, 90, 56, 16, WS_TABSTOP
END

IDD_SHORTCUTS DIALOGEX 0, 0, 260, 160
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Raccourcis clavier"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Ctrl + N", IDC_STATIC, 16, 18, 70, 10
    LTEXT           "Ajouter un téléchargement", IDC_SC_TXT_ADD, 96, 18, 148, 10
    LTEXT           "Suppr", IDC_SC_KEY_DELETE, 16, 36, 70, 10
    LTEXT           "Supprimer la sélection", IDC_SC_TXT_REMOVE, 96, 36, 148, 10
    LTEXT           "Ctrl + F", IDC_STATIC, 16, 54, 70, 10
    LTEXT           "Rechercher", IDC_SC_TXT_SEARCH, 96, 54, 148, 10
    LTEXT           "Ctrl + Maj + V", IDC_SC_KEY_BATCH, 16, 72, 70, 10
    LTEXT           "Téléchargement par lot", IDC_SC_TXT_BATCH, 96, 72, 148, 10
    LTEXT           "F1", IDC_STATIC, 16, 90, 70, 10
    LTEXT           "Aide", IDC_SC_TXT_HELP, 96, 90, 148, 10
    LTEXT           "Échap", IDC_SC_KEY_ESCAPE, 16, 108, 70, 10
    LTEXT           "Fermer la boîte de dialogue", IDC_SC_TXT_CLOSE, 96, 108, 148, 10
    DEFPUSHBUTTON   "OK", IDOK, 102, 134, 56, 16, WS_TABSTOP
END

IDD_SETTINGS DIALOGEX 0, 0, 340, 258
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration d'Anime Download Manager"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 220, 236, 52, 14, WS_TABSTOP
    PUSHBUTTON      "Annuler", IDCANCEL, 280, 236, 52, 14, WS_TABSTOP
END

IDD_SET_GENERAL DIALOGEX 0, 0, 322, 204
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            "", IDC_SET_ICON, 12, 8, 20, 20
    RTEXT           "Intégration au navigateur / Système", IDC_SET_HEADING, 60, 14, 250, 10
    AUTOCHECKBOX    "", IDC_SET_AUTOSTART, 12, 42, 298, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SET_CLIPBOARD, 12, 58, 298, 10, WS_TABSTOP
    LTEXT           "Intégration aux navigateurs suivants :", IDC_SET_LBL_BROWSERS, 12, 82, 298, 10
    CONTROL         "", IDC_SET_BROWSERS, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,
                    12, 95, 298, 76
    LTEXT           "", IDC_SET_BROWSERS_HINT, 12, 175, 298, 10
    LTEXT           "", IDC_SET_LBL_PANEL, 12, 191, 232, 10
    PUSHBUTTON      "", IDC_SET_PANEL_EDIT, 250, 188, 60, 14, WS_TABSTOP
END

IDD_PANEL DIALOGEX 0, 0, 280, 150
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Personnalisation du panneau de téléchargement"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PANEL_LBL_MODE, 12, 12, 256, 10
    AUTORADIOBUTTON "", IDC_PANEL_FULL, 12, 30, 110, 10, WS_GROUP | WS_TABSTOP
    CONTROL         "", IDC_PANEL_PREVIEW_FULL, "Static", SS_OWNERDRAW, 130, 25, 138, 20
    AUTORADIOBUTTON "", IDC_PANEL_MINI, 12, 56, 110, 10
    CONTROL         "", IDC_PANEL_PREVIEW_MINI, "Static", SS_OWNERDRAW, 130, 51, 138, 20
    LTEXT           "", IDC_PANEL_LBL_WHERE, 12, 82, 256, 10
    AUTOCHECKBOX    "", IDC_PANEL_ON_PAGE, 12, 98, 256, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_PANEL_ON_LINKS, 12, 112, 256, 10, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 156, 130, 52, 14, WS_TABSTOP
    PUSHBUTTON      "Annuler", IDCANCEL, 216, 130, 52, 14, WS_TABSTOP
END

IDD_SET_SAVE DIALOGEX 0, 0, 322, 204
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Dossier de téléchargement", IDC_SET_LBL_FOLDER, 12, 14, 298, 10
    EDITTEXT        IDC_SET_FOLDER, 12, 28, 276, 12, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", IDC_SET_BROWSE, 294, 27, 16, 14, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SET_REMEMBER, 12, 48, 298, 10, WS_TABSTOP
    LTEXT           "Icônes de dossier", IDC_SET_LBL_ICONS, 12, 76, 298, 10
    AUTOCHECKBOX    "", IDC_SET_FOLDER_ICONS, 12, 90, 298, 10, WS_TABSTOP
    LTEXT           "Modèle de design :", IDC_SET_LBL_TEMPLATE, 24, 108, 90, 10
    COMBOBOX        IDC_SET_TEMPLATE, 118, 106, 180, 160, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Compatibilité Aniyomi", IDC_SET_LBL_ANIYOMI, 12, 138, 298, 10
    AUTOCHECKBOX    "", IDC_SET_ANIYOMI, 12, 152, 298, 24, BS_MULTILINE | BS_TOP | WS_TABSTOP
END

IDD_SET_DOWNLOADS DIALOGEX 0, 0, 322, 204
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Téléchargements simultanés :", IDC_SET_LBL_RUNNING, 12, 17, 170, 10
    EDITTEXT        IDC_SET_RUNNING, 186, 15, 40, 12, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL         "", IDC_SET_RUNNING_SPIN, "msctls_updown32",
                    UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT           "Connexions par téléchargement :", IDC_SET_LBL_CONNECTIONS, 12, 39, 170, 10
    EDITTEXT        IDC_SET_CONNECTIONS, 186, 37, 40, 12, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    CONTROL         "", IDC_SET_CONNECTIONS_SPIN, "msctls_updown32",
                    UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT           "", IDC_SET_LIMITS_HINT, 12, 64, 298, 30
END

