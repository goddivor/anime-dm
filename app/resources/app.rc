#include <windows.h>
#include <commctrl.h>
#include "../ui/Resource.h"

#pragma code_page(65001)

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDD_ADD_DOWNLOAD DIALOGEX 0, 0, 520, 382
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ajouter un téléchargement"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Source :", IDC_ADD_LBL_SOURCE, 12, 10, 60, 10
    COMBOBOX        IDC_ADD_SOURCE, 76, 8, 360, 140, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

    LTEXT           "Lien de l'animé :", IDC_ADD_LBL_URL, 12, 32, 120, 10
    EDITTEXT        IDC_ADD_URL, 12, 44, 356, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Valider", IDC_ADD_FETCH, 374, 43, 62, 16, WS_TABSTOP

    LTEXT           "", IDC_ADD_TITLE, 12, 68, 424, 14
    LTEXT           "", IDC_ADD_COUNT, 12, 84, 424, 10

    CONTROL         "", IDC_ADD_POSTER, "Static", SS_OWNERDRAW | SS_NOTIFY, 448, 8, 60, 90
    CONTROL         "", IDC_ADD_SEP1, "Static", SS_ETCHEDHORZ, 12, 106, 496, 1

    LTEXT           "Épisodes :", IDC_ADD_LBL_EPISODES, 12, 118, 100, 10
    CONTROL         "", IDC_ADD_PLAYER, "Button", BS_OWNERDRAW | WS_TABSTOP, 140, 114, 190, 18
    CONTROL         "", IDC_ADD_MODE_TEXT, "Button", BS_OWNERDRAW | WS_TABSTOP, 398, 114, 54, 18
    CONTROL         "", IDC_ADD_MODE_LIST, "Button", BS_OWNERDRAW | WS_TABSTOP, 454, 114, 54, 18

    EDITTEXT        IDC_ADD_SELECTION, 12, 138, 496, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "", IDC_ADD_EPISODES, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER |
                    WS_BORDER | WS_TABSTOP, 12, 138, 496, 150

    LTEXT           "", IDC_ADD_HINT, 12, 294, 340, 10
    RTEXT           "", IDC_ADD_COUNTER, 428, 294, 80, 10

    CONTROL         "", IDC_ADD_SEP2, "Static", SS_ETCHEDHORZ, 12, 308, 496, 1
    LTEXT           "Destination :", IDC_ADD_LBL_DEST, 12, 318, 60, 10
    EDITTEXT        IDC_ADD_DEST, 74, 316, 362, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Parcourir...", IDC_ADD_BROWSE, 442, 315, 66, 16, WS_TABSTOP
    LTEXT           "Icône du dossier :", IDC_ADD_LBL_TEMPLATE, 12, 340, 60, 10
    COMBOBOX        IDC_ADD_TEMPLATE, 74, 338, 200, 160, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

    DEFPUSHBUTTON   "Télécharger", IDOK, 340, 360, 100, 18, WS_TABSTOP
    PUSHBUTTON      "Annuler", IDCANCEL, 446, 360, 62, 18, WS_TABSTOP
END

IDD_ABOUT DIALOGEX 0, 0, 260, 116
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "À propos"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Anime Download Manager", IDC_STATIC, 16, 16, 228, 12
    LTEXT           "Version 0.1.0", IDC_STATIC, 16, 34, 228, 10
    LTEXT           "Gestionnaire de téléchargement d'animés pour Windows (C++ / Win32).",
                    IDC_ABOUT_TAGLINE, 16, 52, 228, 24
    DEFPUSHBUTTON   "OK", IDOK, 102, 90, 56, 16, WS_TABSTOP
END

IDD_SHORTCUTS DIALOGEX 0, 0, 260, 160
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Raccourcis clavier"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Ctrl + N", IDC_STATIC, 16, 18, 70, 10
    LTEXT           "Ajouter un téléchargement", IDC_SC_TXT_ADD, 96, 18, 148, 10
    LTEXT           "Suppr", IDC_SC_KEY_DELETE, 16, 36, 70, 10
    LTEXT           "Supprimer la sélection", IDC_SC_TXT_REMOVE, 96, 36, 148, 10
    LTEXT           "Ctrl + F", IDC_STATIC, 16, 54, 70, 10
    LTEXT           "Rechercher", IDC_SC_TXT_SEARCH, 96, 54, 148, 10
    LTEXT           "Ctrl + Maj + V", IDC_SC_KEY_BATCH, 16, 72, 70, 10
    LTEXT           "Téléchargement par lot", IDC_SC_TXT_BATCH, 96, 72, 148, 10
    LTEXT           "F1", IDC_STATIC, 16, 90, 70, 10
    LTEXT           "Aide", IDC_SC_TXT_HELP, 96, 90, 148, 10
    LTEXT           "Échap", IDC_SC_KEY_ESCAPE, 16, 108, 70, 10
    LTEXT           "Fermer la boîte de dialogue", IDC_SC_TXT_CLOSE, 96, 108, 148, 10
    DEFPUSHBUTTON   "OK", IDOK, 102, 134, 56, 16, WS_TABSTOP
END

IDD_SETTINGS DIALOGEX 0, 0, 320, 176
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Icônes de dossier", IDC_SET_LBL_ICONS, 16, 14, 288, 10
    AUTOCHECKBOX    "", IDC_SET_FOLDER_ICONS, 16, 28, 288, 12, WS_TABSTOP
    LTEXT           "Modèle de design :", IDC_SET_LBL_TEMPLATE, 28, 50, 90, 10
    COMBOBOX        IDC_SET_TEMPLATE, 124, 48, 180, 160, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Compatibilité Aniyomi", IDC_SET_LBL_ANIYOMI, 16, 80, 288, 10
    AUTOCHECKBOX    "", IDC_SET_ANIYOMI, 16, 94, 288, 24, BS_MULTILINE | BS_TOP | WS_TABSTOP
    DEFPUSHBUTTON   "Terminé", IDOK, 236, 148, 68, 16, WS_TABSTOP
END

IDD_SEARCH DIALOGEX 0, 0, 340, 220
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rechercher"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Rechercher :", IDC_SEARCH_LBL_QUERY, 12, 16, 44, 10
    EDITTEXT        IDC_SEARCH_QUERY, 60, 14, 200, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Rechercher", IDOK, 266, 13, 62, 16, WS_TABSTOP
    LTEXT           "Dans :", IDC_SEARCH_LBL_SCOPE, 12, 38, 44, 10
    COMBOBOX        IDC_SEARCH_SCOPE, 60, 36, 120, 120, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL         "", IDC_SEARCH_RESULTS, "SysListView32",
                    LVS_REPORT | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 12, 58, 316, 132
    PUSHBUTTON      "Fermer", IDCANCEL, 272, 196, 56, 16, WS_TABSTOP
END

IDD_NOTICE DIALOGEX 0, 0, 230, 92
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Information"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_NOTICE_TEXT, 16, 18, 198, 34
    DEFPUSHBUTTON   "OK", IDOK, 87, 64, 56, 16, WS_TABSTOP
END

IDD_CONFIRM DIALOGEX 0, 0, 260, 108
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirmation"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CONFIRM_TEXT, 16, 16, 228, 30
    CONTROL         "", IDC_CONFIRM_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 52, 228, 12
    DEFPUSHBUTTON   "OK", IDOK, 128, 80, 56, 16, WS_TABSTOP
    PUSHBUTTON      "Annuler", IDCANCEL, 188, 80, 56, 16, WS_TABSTOP
END

IDD_ADDONS DIALOGEX 0, 0, 420, 260
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Addon Store"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ADDONS_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
                    12, 12, 396, 186
    LTEXT           "", IDC_ADDONS_STATUS, 12, 206, 250, 10
    PUSHBUTTON      "Actualiser", IDC_ADDONS_REFRESH, 12, 222, 62, 16, WS_TABSTOP
    PUSHBUTTON      "Installer", IDC_ADDONS_INSTALL, 80, 222, 62, 16, WS_TABSTOP
    PUSHBUTTON      "Supprimer", IDC_ADDONS_REMOVE, 148, 222, 62, 16, WS_TABSTOP
    PUSHBUTTON      "Configurer", IDC_ADDONS_CONFIGURE, 216, 222, 62, 16, WS_TABSTOP
    PUSHBUTTON      "Fermer", IDCANCEL, 346, 222, 62, 16, WS_TABSTOP
END

IDD_ADDON_CONFIG DIALOGEX 0, 0, 300, 220
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CONFIG_AREA, 12, 12, 276, 170
    DEFPUSHBUTTON   "OK", IDOK, 176, 194, 56, 16, WS_TABSTOP
    PUSHBUTTON      "Annuler", IDCANCEL, 236, 194, 52, 16, WS_TABSTOP
END

IDD_POSTER DIALOGEX 0, 0, 300, 440
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Affiche"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_POSTER_IMAGE, "Static", SS_OWNERDRAW, 12, 12, 276, 388
    PUSHBUTTON      "Enregistrer l'image", IDC_POSTER_SAVE, 12, 410, 110, 18, WS_TABSTOP
    DEFPUSHBUTTON   "Fermer", IDCANCEL, 232, 410, 56, 18, WS_TABSTOP
END
