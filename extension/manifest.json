{
  "manifest_version": 3,
  "name": "Anime Download Manager",
  "short_name": "ADM",
  "version": "0.2.0",
  "description": "Download anime in one click with Anime Download Manager.",
  "default_locale": "fr",
  "icons": {
    "16": "icons/adm-16.png",
    "32": "icons/adm-32.png",
    "48": "icons/adm-48.png",
    "128": "icons/adm-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Anime Download Manager",
    "default_icon": {
      "16": "icons/adm-16.png",
      "32": "icons/adm-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "adm@animedm.app",
      "strict_min_version": "121.0"
    }
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "icons/adm-32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
